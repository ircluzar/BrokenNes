<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       BrokenNes2: FL Studio native instrument. Plugin mode of BrokenNes, as a Native AOT DLL.

       FL looks for  <FL>\Plugins\Fruity\Generators\BrokenNes2\BrokenNes2_x64.dll  and calls its
       single export, CreatePlugInstance. Publish with:  dotnet publish -c Release
       (the Native AOT linker needs the MSVC tools; if "vswhere.exe is not recognized", add
        %ProgramFiles(x86)%\Microsoft Visual Studio\Installer to PATH).
       ========================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>BrokenNes2_x64</AssemblyName>
    <Version>0.2.0</Version>
    <Product>BrokenNes2</Product>
    <Company>BrokenNes</Company>
    <RootNamespace>BrokenNes2</RootNamespace>
    <!-- The linked emulator cores' existing warnings; the AOT/trim warnings in them are known (the
         assembly is preserved whole, see Core/ILLink.Descriptors.xml). -->
    <NoWarn>$(NoWarn);IL2026;IL2067;IL2070;IL2075;IL3050;IL3053</NoWarn>
    <!-- The Nano GB chip's presets (Core: NesEmulator.Gb.NanoGbPresets) are read from their JSON with the reflection serializer; Native AOT turns that off by default
         (the table came out empty in the DLL: 0 presets). Core is preserved whole (Core/ILLink.Descriptors.xml), so reflection over its types works. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- the game ROM mode runs until another is loaded (VRUN, frozen build) -->
    <EmbeddedResource Include="Resources/default.nes" LogicalName="default.nes" />
    <!-- the About window's text: plain text you can edit (see About.cs for the little markup) -->
    <EmbeddedResource Include="Resources/about.txt" LogicalName="about.txt" />
    <!-- Test MIDI export (round 7): VRUN's AudioPlayer with padded stream arrays, and its manifest (made by BrokenDev/tools/music/build-musictest.ps1; Music/MusicTemplate.cs reads them) -->
    <EmbeddedResource Include="Resources/musictest.nes" LogicalName="musictest.nes" />
    <EmbeddedResource Include="Resources/musictest.txt" LogicalName="musictest.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native AOT: the JSON converters the Nano GB preset table needs (see rd.xml) -->
    <RdXmlFile Include="rd.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrokenNes.Fruity\BrokenNes.Fruity.csproj" />
    <ProjectReference Include="..\..\Core\BrokenNes.Core.csproj" />
  </ItemGroup>

</Project>
