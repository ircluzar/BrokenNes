<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);FAST_EMU;HEADLESS</DefineConstants>
    <NoWarn>$(NoWarn);CA1416;CS8602;CS8618;CS8600;CS8601;CS8603;CS8604;CS0168;CS0219;CS0414;CS0649;CS0169;CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Windows/NesEmulator/**/*.cs" LinkBase="NesEmulator" />
    <Compile Remove="../../Windows/NesEmulator/board/Emulator*.cs" />
    <Compile Remove="../../Windows/NesEmulator/board/NesController.cs" />
    <Compile Remove="../../Windows/NesEmulator/board/Benchmark.cs" />
    <Compile Remove="../../Windows/NesEmulator/board/StatePersistence.cs" />
    <Compile Remove="../../Windows/NesEmulator/board/ClockRegistry.cs" />
    <Compile Remove="../../Windows/NesEmulator/UI.cs" />
    <Compile Remove="../../Windows/NesEmulator/corruptor/GlitchHarvester.cs" />
    <Compile Remove="../../Windows/NesEmulator/StatusService.cs" />
    <Compile Remove="../../Windows/NesEmulator/clocks/**" />
    <Compile Include="../../Windows/Rendering/ColorMath.cs" Link="Shared/ColorMath.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MeltySynth" Version="2.4.0" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />
  </ItemGroup>
</Project>
