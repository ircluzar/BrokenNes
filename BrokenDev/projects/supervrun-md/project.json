{
  "schema": 1,
  "id": "supervrun-md",
  "title": "Super VRUN on the Genesis / Mega Drive (S3)",
  "family": "supervrun",
  "kind": "md",
  "console": "md",
  "description": "The Genesis port of Super VRUN (docs/projects/sega-vrun-ports-plan.md, S3: 1P and 2P, the game centred in 320 with each room's edges repeated like the WideMess version, Super VRUN's own music engine on FM + PSG, ONE shared game-logic source with the SNES and WideMess versions: the proposal is in the workspace's README.md). S3: the whole game (logic, picture; sound is M4). Built with SGDK 2.11 (toolchains.json) in its live workspace PROJECTS/SuperVRUN_MD_dev (its own git, local only).",
  "source": {
    "folder": "{live:SuperVRUN_MD_dev}"
  },
  "requires": {
    "tools": [
      "ps5",
      "toolchain:sgdk"
    ],
    "projects": [],
    "inputs": [],
    "toolchain": [
      "SGDK 2.11 (m68k gcc, make, libmd), pinned in toolchains.json; Java (the machine's JDK) for SGDK's sizebnd.jar / rescomp.jar"
    ]
  },
  "build": {
    "steps": [
      {
        "name": "build",
        "shell": "ps5",
        "cwd": "{src}",
        "file": "{src}/build.ps1",
        "args": [
          "-Sgdk",
          "{toolchain:sgdk}"
        ],
        "timeoutSec": 900,
        "note": "build.ps1: SGDK's makefile.gen release (-O3, LTO) into out/, then build/supervrun_md.bin and its nm symbols; checks the 'SEGA' system name at $100."
      }
    ],
    "outputs": [
      {
        "id": "rom",
        "path": "{src}/build/supervrun_md.bin",
        "publishAs": "supervrun_md.md",
        "kind": "md"
      },
      {
        "id": "nm",
        "path": "{src}/build/supervrun_md.nm.txt",
        "publishAs": "supervrun_md.nm.txt",
        "kind": "symbols"
      }
    ]
  },
  "run": {
    "console": "md",
    "note": "The game: Start on the title, Start again in the menu, then play (D-pad, A/B/C, Start+A or Mode = Select). Lite: the .md opens in BrokenNes Lite's Genesis (UAT/entrypoints/lite-sega.ps1 -Roms <folder with md\\supervrun_md.md>)."
  },
  "verify": {
    "timeoutSec": 600,
    "scenarios": [
      {
        "id": "boot-to-game",
        "frames": 900,
        "input": "300:Start,310:,420:Start,430:",
        "checkpoints": [
          200,
          900
        ],
        "expect": {
          "minDistinctColors": 2,
          "pictureDiffers": [
            200,
            900
          ],
          "memory": [
            {
              "symbol": "title_frames",
              "size": 2,
              "endian": "big",
              "min": 100,
              "what": "the title runs (its tick counts)"
            },
            {
              "symbol": "cur_state_seen",
              "size": 1,
              "is": 1,
              "what": "Start, Start reached gameplay (STATE_GAME)"
            },
            {
              "symbol": "game_frames",
              "size": 2,
              "endian": "big",
              "min": 60,
              "what": "gameplay updates every tick"
            }
          ]
        },
        "why": "the game boots on the Genesis, the title animates, the pad reaches the game and it runs"
      }
    ]
  },
  "compat": {
    "what": "The game on every Genesis emulator BrokenDev has (BizHawk's Genplus-gx), from power-on and the same pad script: title, Start, Start, gameplay. Variables are big-endian u16: the low byte is the symbol + 1.",
    "symbols": {
      "file": "{out}/supervrun_md.nm.txt"
    },
    "reads": {
      "title": "title_frames+1",
      "game": "game_frames+1",
      "state": "cur_state_seen"
    },
    "frameTolerance": 30,
    "scenarios": [
      {
        "id": "boot-to-game",
        "frames": 900,
        "input": "300:Start,310:,420:Start,430:",
        "shots": [
          200,
          900
        ],
        "what": "power-on, title, Start twice, gameplay",
        "checks": [
          {
            "id": "title",
            "what": "the title runs (title_frames' low byte keeps changing)",
            "changes": "title",
            "within": [
              60,
              290
            ],
            "min": 100
          },
          {
            "id": "game",
            "what": "Start, Start reached gameplay",
            "read": "state",
            "is": 1,
            "within": [
              700,
              900
            ],
            "hold": true
          },
          {
            "id": "alive",
            "what": "gameplay runs (game_frames' low byte keeps changing)",
            "changes": "game",
            "within": [
              700,
              900
            ],
            "min": 100
          },
          {
            "id": "drawn",
            "what": "the room is drawn",
            "picture": 900,
            "minColors": 2
          }
        ]
      }
    ]
  },
  "comparison": {
    "what": "S3 M2: the Genesis port's logic (logic/ = a copy of the SNES C, the 98 asm paths as C) against Super VRUN on the SNES (project supervrun). Same game code, so the tolerance is tight: the same events in order within 2 ticks, positions within 1 pixel. Both 60 Hz, time = the game's own tick (game_frames, one per gameplay update), because the two CPUs spend different frames loading a room; input tick: pads by frame until the game starts, then by game tick. Variables by symbol on both sides (SNES: WLA .sym; Genesis: SGDK nm). The SNES keeps u16 little-endian (pixel = byte +1); the 68000 big-endian (pixel = byte +0). p2ctx (the stored player, 2P) is in the SNES byte layout on both (BACKPORT 7). Pads: SNES Y->A, A->C, B->B, X->X, L->Y, R->Z, Select->Mode (platform/md/plat_md.c's map). TRAP: in a SNES expression a symbol's value loses its bank once arithmetic is applied ([player_x + 1] reads bank 0 = ROM): add the bank, [player_x + $7E0001].",
    "original": "supervrun",
    "rate": {
      "original": {
        "fps": 60,
        "tick": "{title_frames} + {game_frames}"
      },
      "port": {
        "fps": 60,
        "tick": "(([title_frames]) << 8 | [title_frames + 1]) + (([game_frames]) << 8 | [game_frames + 1])"
      }
    },
    "input": "tick",
    "tolerance": {
      "ticks": 2,
      "positions": 4
    },
    "sampleEveryTicks": 10,
    "variables": [
      {
        "name": "slot",
        "kind": "event",
        "original": "slot_current",
        "port": "slot_current"
      },
      {
        "name": "state",
        "kind": "event",
        "original": "cur_state_seen",
        "port": "cur_state_seen"
      },
      {
        "name": "room",
        "kind": "event",
        "original": "room_current",
        "port": "room_current"
      },
      {
        "name": "hp",
        "kind": "event",
        "original": "player_hp",
        "port": "player_hp"
      },
      {
        "name": "cash",
        "kind": "event",
        "original": "le16 player_score",
        "port": "be16 player_score"
      },
      {
        "name": "cur",
        "kind": "event",
        "original": "player_cur",
        "port": "player_cur"
      },
      {
        "name": "x",
        "kind": "position",
        "original": "[player_x + $7E0001]",
        "port": "[player_x]"
      },
      {
        "name": "y",
        "kind": "position",
        "original": "[player_y + $7E0001]",
        "port": "[player_y]"
      },
      {
        "name": "p2x",
        "kind": "position",
        "original": "[p2ctx + $7E0001]",
        "port": "[p2ctx + 1]"
      },
      {
        "name": "p2y",
        "kind": "position",
        "original": "[p2ctx + $7E0003]",
        "port": "[p2ctx + 3]"
      },
      {
        "name": "p2hp",
        "kind": "event",
        "original": "[p2ctx + $7E000E]",
        "port": "[p2ctx + 14]"
      },
      {
        "name": "enemies",
        "kind": "event",
        "original": "room_enemies_remaining",
        "port": "room_enemies_remaining"
      }
    ],
    "buttons": {
      "Y": "A",
      "A": "C",
      "L": "Y",
      "R": "Z",
      "Select": "Mode"
    },
    "settleFrames": 200,
    "tickLead": -1,
    "play": {
      "what": "D1 (Timeflow T6): brokendev.ps1 timeflow play-compare supervrun-md. The SNES original built from logic/SOURCE.txt's SuperVRUN_dev commit (git archive, its snes-stub toolchain joined from C:\\BrokenNes-tools), the port into C:\\BrokenNes-work\\play-compare (the shipping build is not touched); the seed is the title's frame count (the map slot), fixed by Start at frames 300 and 420 from power-on. Then a scripted walk out of room 0 (right, shooting, a jump) and a seeded walker that jumps (B) and shoots (Y): rooms, enemies, hits. The port repository's tools/compare_manifest.json (tickLeadWhen) is the mapping.",
      "frames": 8000,
      "input": "300:Start,310:,420:Start,430:,951:Right,1101:Right+Y,1111:Right,1121:Right+Y,1131:Right,1141:Right+B,1161:Right,1201:Right+Y,1211:Right,1301:,1320:Y,1340:Right+B,1360:,1380:Y,1420:B+Up,1440:Left+B+Y+Down,1460:Y,1480:Right,1500:Left+B,1520:Right+Down,1560:B+Up,1580:,1600:Right,1620:Left,1640:,1660:Right+B,1680:Right,1700:Right+B,1720:Right,1780:Right+B,1820:Right,1860:Left+B+Up,1880:Right,1920:Left,1940:Right+Down,1960:Right,1980:Down,2000:Right+Y,2020:,2040:Right+B+Y,2060:Y,2080:Right+Y,2100:Right,2120:B+Y,2140:Right,2160:Left+B+Down,2180:,2200:Right,2240:Right+Up,2260:Right,2280:,2300:Right+Y,2340:Up,2360:Left,2380:,2400:Right+B+Down,2420:Right,2440:Right+B,2460:B,2480:,2500:Right,2520:Right+B,2540:Left+B,2560:Left+Y,2580:Left+Up,2600:,2620:Right+B+Y+Down,2640:Right,2660:Left,2680:Right+B,2700:Right,2720:Right+Up,2740:Right+B+Down,2760:Right+B,2780:Left+B,2800:Left+B+Y,2820:Right+Y,2840:Right+B+Up,2860:Right,2880:B+Y,2900:Left+Y,2920:,2940:Right,2980:Right+B+Y,3000:Left+B,3020:Down,3040:Y,3060:Right,3080:,3100:Right+Down,3120:Right+B,3140:B,3160:Right,3180:Y,3200:B,3220:Right+B+Y,3240:Right+Y,3260:Right+Up,3280:Right+B,3300:Right,3320:Right+Y+Down,3340:Right,3360:Left,3380:Left+Up,3400:Right+B+Y,3420:Right+Down,3440:Right+B+Y,3460:,3480:Right,3500:Left+Y,3520:Left+B,3540:Left,3560:,3600:Right,3620:Right+B+Down,3640:Right+Y,3660:Up,3680:Left+B,3700:Left+B+Up,3720:Right,3740:Right+Up,3760:Right+B+Y,3780:Left+Y,3800:Right+Y,3820:B,3840:Right+Down,3860:Right,3880:Left,3900:Left+Down,3920:Right+B+Down,3940:Right+B,3960:Right,4000:Left+B+Down,4020:Right,4060:Right+Down,4080:Left,4100:Right+B,4120:Left+Y+Up,4140:Y,4160:,4180:B+Down,4200:Left,4220:Right+B+Y,4240:Right+Y,4260:Right+B,4280:Right,4340:Right+Up,4360:B,4380:Right,4400:Left,4420:Right+B+Up,4440:,4460:Right+Y+Down,4480:Right+B,4500:Y,4520:Right+Up,4540:Right+B,4560:Up,4580:Right+B,4600:,4620:Left+B,4640:Left,4660:,4680:Left,4700:Right,4720:Left+B,4740:Down,4780:Right+B+Y+Down,4800:Right+Down,4820: