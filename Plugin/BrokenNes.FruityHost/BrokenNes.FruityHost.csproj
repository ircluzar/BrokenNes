<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       BrokenNes.FruityHost: the plugin test bench, outside FL Studio.

       A faithful stand-in for FL's host: it loads a native Fruity plugin DLL (BrokenNes2_x64.dll),
       gives it the host object FL would (the C++-vtable-shaped TFruityPlugHost), plays timelines of
       notes with slides and bends the way FL's mixer does (voices, release, kill, ticks), and
       checks the sound that comes out. `selftest` runs the whole certification suite;
       `analyze` applies the same checks to a WAV rendered by real FL Studio (UAT/plugin).
       ========================================================================== -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BrokenNes.FruityHost</RootNamespace>
    <AssemblyName>BrokenNes.FruityHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrokenNes.Fruity\BrokenNes.Fruity.csproj" />
    <!-- HostSim / PluginInstance / PluginLibrary live there now (still namespace BrokenNes.FruityHost): the desktop's standalone synth hosts the plugin with them too -->
    <ProjectReference Include="..\BrokenNes.SynthHost\BrokenNes.SynthHost.csproj" />
    <!-- Round 5 (corruption): the `corruption` check farms a corruption the way the desktop app does (the shared library: stockpile file, memory domains, anchors) and the synthetic SNES game
         the library's own tests use, then drives the plugin's Corruption window with real mouse messages. Test-only; the plugin DLL does not come through here. -->
    <ProjectReference Include="..\..\Core\BrokenNes.Core.csproj" />
    <Compile Include="..\..\Workshop\Corruption\SynthSnesRom.cs" Link="SynthSnesRom.cs" />
    <Compile Include="..\BrokenNes2.Plugin\SpcSnapshot.cs" Link="SpcSnapshot.cs" />
    <!-- Round 6 (imodel): the instrument model and the samplers it is checked against (the `imodel` check renders PCM through the very sampler classes the plugin DLL uses, from the same source files) -->
    <Compile Include="..\BrokenNes2.Plugin\SnesSampler.cs" Link="SnesSampler.cs" />
    <Compile Include="..\BrokenNes2.Plugin\GbSampler.cs" Link="GbSampler.cs" />
    <Compile Include="..\BrokenNes2.Plugin\SegaSnapshot.cs" Link="SegaSnapshot.cs" />
    <Compile Include="..\BrokenNes2.Plugin\SegaSamplers.cs" Link="SegaSamplers.cs" />
    <!-- (InstrumentsUi.cs is the glue to the plugin's tabs and emulator: it is tested through the DLL, not linked) -->
    <Compile Include="..\BrokenNes2.Plugin\Instruments\*.cs" Exclude="..\BrokenNes2.Plugin\Instruments\InstrumentsUi.cs" LinkBase="Instruments" />
    <!-- Round 6 (presets): the preset file, the engines' snapshots and the folder library (pure code; PresetLibrary, the plugin glue and the editor's picker are tested through the DLL) -->
    <Compile Include="..\BrokenNes2.Plugin\Presets\*.cs" LinkBase="Presets" />
  </ItemGroup>

</Project>
