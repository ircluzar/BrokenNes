{
 "hardware": {
  "machine": "WIN98-P166-NANO",
  "video": "GEFORCE",
  "ram_mb": 64,
  "min_cpu": "P90",
  "sound": "SB16_D072",
  "3d": "GeForce 256 (NVIDIA 5.32, OpenGL ICD) or software on the S3"
 },
 "launch": {
  "exe": "C:/QUAKE2/quake2.exe",
  "args": "+set cddir d:/install/data",
  "cwd": "C:/QUAKE2"
 },
 "cd": [{"label": "Quake2", "ref": "quake2.cue", "required": true, "note": "user's own disc rip (BIN/CUE for CD audio); never shipped"}],
 "presets": {
  "geforce": {"video_arg": "--video geforce", "args": "+set vid_ref gl", "renderer": "opengl"},
  "software": {"video_arg": "--video s3", "args": "+set vid_ref soft", "renderer": "software"}
 },
 "saves": ["C:/QUAKE2/baseq2/save/*", "C:/QUAKE2/baseq2/config.cfg"]
}
