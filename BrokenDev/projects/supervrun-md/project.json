      "manifest": "{src}/tools/compare_manifest.json",
      "original": {
        "kind": "archive",
        "repo": "{live:SuperVRUN_dev}",
        "commitFile": "{src}/logic/SOURCE.txt",
        "into": ".",
        "links": {
          "snes-stub/toolchain": "C:/BrokenNes-tools/supervrun/snes-stub/toolchain"
        },
        "cwd": "snes-dev/supervrun",
        "bash": "bash build.sh",
        "rom": "snes-dev/supervrun/build/supervrun.sfc",
        "symbols": [
          "snes-dev/supervrun/build/supervrun.sym"
