<Project Sdk="Microsoft.NET.Sdk">

  <!-- BrokenNes Nano Genesis: the C# side of the parity proof. It replays what the web library did to its chip (PSG and YM2612 writes, runs,
       reads) through Core's Ym2612 + Sn76489 (the Genesis unit's chips, menu id MD) and writes the PCM.
       Not part of BrokenNes.sln; built on demand by Nano/genesis/test/parity.mjs. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BrokenNes.NanoGenesis</RootNamespace>
    <AssemblyName>NanoGenesisParity</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Core\BrokenNes.Core.csproj" />
  </ItemGroup>

</Project>
