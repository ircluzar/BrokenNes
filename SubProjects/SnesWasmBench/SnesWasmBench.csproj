<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Measures the SFC (SNES) cores where they will actually ship: in the browser, under WASM.
       Interpreter build: dotnet publish -c Release -o <dir>
       AOT build:         dotnet publish -c Release -p:EnableWasmAot=true -o <dir>
       Serve <dir>/wwwroot with serve.mjs (see README.md). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Same pin as Web/: without it the managed corlib and the native Mono/AOT bits can resolve
         to different runtime packs and boot fails with "out of sync library". -->
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <EnableWasmAot Condition="'$(EnableWasmAot)'==''">false</EnableWasmAot>
    <RunAOTCompilation Condition="'$(Configuration)'=='Release'">$(EnableWasmAot)</RunAOTCompilation>
    <RunAOTCompilation Condition="'$(Configuration)'!='Release'">false</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <!-- The SFC cores, linked from their single source of truth. They are pure C# (System only). -->
  <ItemGroup>
    <Compile Include="..\..\Windows\NesEmulator\snes\**\*.cs" LinkBase="snes" />
  </ItemGroup>

</Project>
