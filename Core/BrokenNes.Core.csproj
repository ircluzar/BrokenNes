<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       BrokenNes.Core: the emulator cores as a plain class library, for the third way BrokenNes
       runs - PLUGIN MODE (the BrokenNes2 FL Studio plugin, compiled with Native AOT).

         desktop mode  Windows/BrokenNes.Windows.csproj    (WinForms)
         web mode      Web/, WebLite/                      (Blazor WebAssembly)
         plugin mode   this project                        (net10.0 library, AOT-compatible)

       Like Workshop/, Web/ and WebLite/, it LINKS the cores from Windows/NesEmulator - the
       only place they exist. Nothing is copied or forked, and the other projects are untouched.
       What only plugin hosts need (NesAudioMachine, .mlb symbols, resampler) lives in this
       folder, not in the shared tree.
       ========================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by PPU_EIL/PPU_SPD (same as every other project that links the cores). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>NesEmulator</RootNamespace>
    <AssemblyName>BrokenNes.Core</AssemblyName>
    <!-- The shared tree's existing nullable/style warnings (the other projects silence the same set). -->
    <NoWarn>$(NoWarn);CA1416;CS8602;CS8618;CS8600;CS8601;CS8603;CS8604;CS8625;CS0675;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS8619;CS8629;CS1998</NoWarn>
    <NesRoot>..\Windows\NesEmulator\</NesRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cores are discovered by reflection (CoreRegistry, NullProviderRegistry) and savestates
         serialize by reflection (NES.PlainSerialize). This descriptor keeps the whole assembly
         under trimming / Native AOT, the same job Web/LinkerConfig.xml does for the web build,
         so every core id stays selectable in a plugin. -->
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- board/: explicit list (a glob pulls in the old Blazor shell) - same list as Workshop/. -->
    <Compile Include="$(NesRoot)board\NES.cs"                 Link="NesEmulator\board\NES.cs" />
    <Compile Include="$(NesRoot)board\Bus.cs"                 Link="NesEmulator\board\Bus.cs" />
    <Compile Include="$(NesRoot)board\Cartridge.cs"           Link="NesEmulator\board\Cartridge.cs" />
    <Compile Include="$(NesRoot)board\CoreRegistry.cs"        Link="NesEmulator\board\CoreRegistry.cs" />
    <Compile Include="$(NesRoot)board\CpuSharedState.cs"      Link="NesEmulator\board\CpuSharedState.cs" />
    <Compile Include="$(NesRoot)board\PpuSharedState.cs"      Link="NesEmulator\board\PpuSharedState.cs" />
    <Compile Include="$(NesRoot)board\Input.cs"               Link="NesEmulator\board\Input.cs" />
    <Compile Include="$(NesRoot)board\ApuExtensions.cs"       Link="NesEmulator\board\ApuExtensions.cs" />
    <Compile Include="$(NesRoot)board\SpeedConfig.cs"         Link="NesEmulator\board\SpeedConfig.cs" />
    <Compile Include="$(NesRoot)board\InstructionTracer.cs"   Link="NesEmulator\board\InstructionTracer.cs" />
    <Compile Include="$(NesRoot)board\NesMemoryExtensions.cs" Link="NesEmulator\board\NesMemoryExtensions.cs" />

    <Compile Include="$(NesRoot)cpus\**\*.cs"      LinkBase="NesEmulator\cpus" />
    <Compile Include="$(NesRoot)ppus\**\*.cs"      LinkBase="NesEmulator\ppus" />
    <!-- The PURE-EMULATION APU_WF / APU_MNES (.Web.cs) - no NAudio, no MeltySynth, no files on
         disk - exactly as Web/ does. The desktop siblings play through Windows MIDI / an SF2. -->
    <Compile Include="$(NesRoot)apus\**\*.cs"      LinkBase="NesEmulator\apus"
             Exclude="$(NesRoot)apus\APU_WF.cs;$(NesRoot)apus\APU_MNES.cs" />
    <Compile Include="$(NesRoot)mappers\**\*.cs"   LinkBase="NesEmulator\mappers" />
    <Compile Include="$(NesRoot)expansion\**\*.cs" LinkBase="NesEmulator\expansion" />
    <!-- SNES, Game Boy and the cross-console bridges (APU_DMG/DMGS = NES music on the Game Boy
         sound chip, APU_SNES = on the S-DSP), plus the BrokenNes 2 console sessions. -->
    <Compile Include="$(NesRoot)snes\**\*.cs"      LinkBase="NesEmulator\snes" />
    <Compile Include="$(NesRoot)gb\**\*.cs"        LinkBase="NesEmulator\gb" />
    <Compile Include="$(NesRoot)mix\**\*.cs"       LinkBase="NesEmulator\mix" />
    <Compile Include="$(NesRoot)systems\**\*.cs"   LinkBase="NesEmulator\systems" />

    <!-- nullproviders/: the portable subset (the others need Windows rendering). At least one
         concrete provider must exist - NullProviderRegistry throws on an empty list. -->
    <Compile Include="$(NesRoot)nullproviders\INullProvider.cs"        Link="NesEmulator\nullproviders\INullProvider.cs" />
    <Compile Include="$(NesRoot)nullproviders\NullProviderRegistry.cs" Link="NesEmulator\nullproviders\NullProviderRegistry.cs" />
    <Compile Include="$(NesRoot)nullproviders\StaticNullProvider.cs"   Link="NesEmulator\nullproviders\StaticNullProvider.cs" />
    <Compile Include="$(NesRoot)nullproviders\BlackNullProvider.cs"    Link="NesEmulator\nullproviders\BlackNullProvider.cs" />
  </ItemGroup>

</Project>
