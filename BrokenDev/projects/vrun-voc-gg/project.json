3980:Right+A,4000:Right+B,4020:,4040:Right,4060:Right+A,4080:Right,4100:Right+B,4120:A+B,4140:Right+A,4160:Right,4180:Right+Up,4200:Right,4240:Up,4260:Right,4280:A+B,4300:B+Up,4320:Right,4340:,4360:Right+Up,4380:Right,4400:Right+A,4420:Right,4440:A,4460:Right,4500:Right+A+Down,4520:Right,4540:Right+A,4560:Right,4580:Right+A+Down,4600:Right+A,4620:Right+A+B,4640:,4660:B,4680:Right+Down,4700:Right+B,4720:Right,4740:Right+A,4780:Right,4840:Right+Up,4860:Down,4880:Right+B+Up,4900:Right,4920:Right+A,4940:Right+Up,4960:Right,4980:Right+A+Up,5000:Right+Up,5020:Right+A,5040:Right,5060:A,5080:Right,5100:,5120:Right+A+B,5160:Right+A+Up,5180:Down,5200:Right,5220:Right+B,5240:Right+A,5260:Right,5320:Right+B,5340:A,5360:Right+B,5380:Right,5440:Right+A,5460:,5480:Right,5500:,5520:Right+B,5580:B,5600:Right+B+Down,5620:Right,5640:,5660:Right+A+B,5700:Right+A,5740:,5760:Right,5780:,5800:Right,5820:Right+Up,5840:Right+A,5860:Right,5900:A,5920:Right,5960:Right+A",
      "original": {
        "kind": "ps1",
        "script": "{live:VRUN_VOC_dev}/build.ps1",
        "args": [
          "-Gbdk",
          "{toolchain:gbdk}"
        ],
        "defines": [
          "VOC_GAME_SEED=4321",
          "VOC_GAME_MAP=7"
        ],
        "rom": "vrun_voc.gbc",
        "symbols": [
          "vrun_voc.noi"
        ]
      },
      "port": {
        "kind": "ps1",
        "script": "{src}/build.ps1",
        "args": [
          "-Sdcc",
          "{toolchain:sdcc}",
          "-DevkitSms",
          "{toolchain:devkitsms}"
        ],
        "defines": [
          "VOC_GAME_SEED=4321",
          "VOC_GAME_MAP=7"
        ],
        "rom": "vrun_voc_gg.gg",
        "symbols": [
          "vrun_voc_gg.noi"
        ]
      },
      "expect": {
        "mode": 1,
        "room": 3
      }
    }
  },
  "knownIssues": [
    "No hardware test on the user's Genesis flash cart yet (its built-in Game Gear mode)."
  ]
}
