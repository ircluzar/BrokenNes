<Project Sdk="Microsoft.NET.Sdk">

  <!-- BrokenNes Nano SMS: the C# side of the parity proof. It replays what the web library did to its chip (PSG writes, stereo writes, runs,
       reads) through Core's Sn76489 (the Master System / Game Gear unit's chip, menu id SMS / GG) and writes the PCM.
       Not part of BrokenNes.sln; built on demand by Nano/sms/test/parity.mjs. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BrokenNes.NanoSms</RootNamespace>
    <AssemblyName>NanoSmsParity</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Core\BrokenNes.Core.csproj" />
  </ItemGroup>

</Project>
