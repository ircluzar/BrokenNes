#!/usr/bin/env bash
# Thin wrapper: rebuilds if sources changed (incremental, fast), then runs the harness.
# Emulator debug chatter (lines starting with '[') is filtered unless NESH_RAW=1.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
export PATH="$HOME/.dotnet:$PATH" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
dotnet build "$here/BrokenNes.Headless.csproj" -c Release -v q -nologo 2>&1 | grep -E " error " && exit 2
if [ "${NESH_RAW:-0}" = 1 ]; then exec dotnet "$here/bin/Release/net10.0/BrokenNes.Headless.dll" "$@"; fi
dotnet "$here/bin/Release/net10.0/BrokenNes.Headless.dll" "$@" | grep -v '^\['
exit "${PIPESTATUS[0]}"
